---
// src/pages/index.astro
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Authors Freedom</title>
    <!-- Google Monospace Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="page-container">
      <!-- Simulated Writing Software / Text Editor Window -->
      <div class="editor-window">
        <div class="editor-titlebar">
          <div class="window-controls">
            <span class="control close"></span>
            <span class="control minimize"></span>
            <span class="control expand"></span>
          </div>
          <span class="file-name">coming-soon.txt — Editing</span>
        </div>

        <div class="editor-body">
          <p class="editor-text">
            <span id="typed-text"></span><span id="cursor" class="cursor"
            ></span>
          </p>
        </div>
      </div>
    </main>

    <!-- Client-side Script for Typing Animation -->
    <script>
      const textToType = "Coming soon...";
      const typedTextElement = document.getElementById("typed-text");
      const cursorElement = document.getElementById("cursor");

      let charIndex = 0;
      let isDeleting = false;

      function typeWriter() {
        if (!typedTextElement || !cursorElement) return;

        // Current slice of the string
        typedTextElement.textContent = textToType.substring(0, charIndex);

        let delay = 240; // Default typing speed

        if (!isDeleting) {
          // Add a tiny random jitter so typing feels natural/human
          delay = 100 + Math.random() * 80;

          if (charIndex < textToType.length) {
            charIndex++;
          } else {
            // Reached the end: pause and let the cursor blink slowly
            cursorElement.classList.add("slow-blink");
            isDeleting = true;
            delay = 2500; // Stay at the end for 2.5 seconds
          }
        } else {
          // Deleting/Backspacing: faster and steady
          cursorElement.classList.remove("slow-blink");
          delay = 45;

          if (charIndex > 0) {
            charIndex--;
          } else {
            // Fully deleted: pause briefly before typing again
            isDeleting = false;
            delay = 700; // Short pause before restarting
          }
        }

        setTimeout(typeWriter, delay);
      }

      // Start typing when the page is loaded
      typeWriter();
    </script>

    <style>
      :root {
        --bg-color: #0e0f12;
        --window-bg: #16181d;
        --border-color: #262933;
        --titlebar-bg: #1c1f26;
        --text-color: #f1f3f8;
        --muted-text: #6b7280;
        --cursor-color: #38bdf8;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background-color: var(--bg-color);
        color: var(--text-color);
        font-family: "Fira Code", monospace;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .page-container {
        width: 100%;
        max-width: 650px;
        padding: 1.5rem;
      }

      /* Editor Window Styling */
      .editor-window {
        background: var(--window-bg);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
        overflow: hidden;
      }

      .editor-titlebar {
        background: var(--titlebar-bg);
        padding: 12px 16px;
        display: flex;
        align-items: center;
        border-bottom: 1px solid var(--border-color);
        user-select: none;
      }

      .window-controls {
        display: flex;
        gap: 8px;
      }

      .control {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        display: inline-block;
      }

      .close {
        background: #ff5f56;
      }
      .minimize {
        background: #ffbd2e;
      }
      .expand {
        background: #27c93f;
      }

      .file-name {
        margin-left: 1rem;
        font-size: 0.8rem;
        color: var(--muted-text);
      }

      .editor-body {
        padding: 3rem 2.5rem;
        min-height: 180px;
        display: flex;
        align-items: center;
      }

      .editor-text {
        font-size: clamp(1.5rem, 4vw, 2.25rem);
        font-weight: 500;
        letter-spacing: -0.02em;
        line-height: 1.4;
      }

      /* Blinking Cursor */
      .cursor {
        display: inline-block;
        width: 3px;
        height: 1.25em;
        background-color: var(--cursor-color);
        margin-left: 4px;
        vertical-align: text-bottom;
        animation: blink 0.75s infinite;
      }

      /* Slower, relaxed blink when idle at the end */
      .cursor.slow-blink {
        animation: blink 1.2s infinite ease-in-out;
      }

      @keyframes blink {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0;
        }
      }
    </style>
  </body>
</html>
